{
  "name": "tensor-viewer",
  "displayName": "NPZ Viewer & NPY Viewer, PyTorch, GGUF & Safetensors (NumPy Viewer)",
  "description": "NPZ and NPY viewer for NumPy arrays, plus PyTorch .pt, .pth and .ckpt checkpoints, GGUF and Safetensors models: names, shape, dtype, stats, heatmaps and images. Reloads when the file changes. Reads pickle without running it. Offline, no Python.",
  "version": "0.6.0",
  "publisher": "zovo",
  "license": "MIT",
  "icon": "icon.png",
  "galleryBanner": {
    "color": "#0B1B33",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.90.0",
    "node": ">=18"
  },
  "categories": [
    "Data Science",
    "Machine Learning",
    "Visualization"
  ],
  "keywords": [
    "npz viewer",
    "npy viewer",
    "numpy viewer",
    "gguf viewer",
    "safetensors viewer",
    "pytorch viewer",
    "pth viewer",
    "pt viewer",
    "tensor viewer",
    "npz",
    "npy",
    "numpy",
    "gguf",
    "safetensors",
    "pth",
    "ckpt",
    "tensor",
    "npy image",
    "raw binary",
    "tofile",
    "llm",
    "llama.cpp",
    "ollama",
    "huggingface",
    "model weights",
    "checkpoint",
    "quantization",
    "machine learning",
    "pytorch",
    "torch"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onUri"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    },
    "virtualWorkspaces": true
  },
  "contributes": {
    "customEditors": [
      {
        "viewType": "tensorViewer.view",
        "displayName": "Tensor Viewer",
        "selector": [
          {
            "filenamePattern": "*.npy"
          },
          {
            "filenamePattern": "*.npz"
          },
          {
            "filenamePattern": "*.safetensors"
          },
          {
            "filenamePattern": "*.gguf"
          },
          {
            "filenamePattern": "*.pt"
          },
          {
            "filenamePattern": "*.pth"
          },
          {
            "filenamePattern": "*.ckpt"
          },
          {
            "filenamePattern": "pytorch_model*.bin"
          }
        ],
        "priority": "default"
      },
      {
        "viewType": "tensorViewer.raw",
        "displayName": "Tensor Viewer (raw binary array)",
        "selector": [
          {
            "filenamePattern": "*.bin"
          },
          {
            "filenamePattern": "*.raw"
          },
          {
            "filenamePattern": "*.dat"
          },
          {
            "filenamePattern": "*.f32"
          },
          {
            "filenamePattern": "*.f64"
          }
        ],
        "priority": "option"
      }
    ],
    "commands": [
      {
        "command": "tensorViewer.openRaw",
        "title": "Open as Raw Array...",
        "category": "Tensor Viewer"
      },
      {
        "command": "tensorViewer.openWalkthrough",
        "title": "Get Started",
        "category": "Tensor Viewer"
      },
      {
        "command": "tensorViewer.supportDeveloper",
        "title": "Support the developer",
        "category": "Tensor Viewer"
      },
      {
        "command": "tensorViewer.moreViewers",
        "title": "More free viewers",
        "category": "Tensor Viewer"
      },
      {
        "command": "tensorViewer.compareFiles",
        "title": "Compare Two Tensor Files (Checkpoint Diff)",
        "category": "NumPy Viewer Pro"
      },
      {
        "command": "tensorViewer.scanTensors",
        "title": "Scan All Tensors for NaN, Inf and Zeros",
        "category": "NumPy Viewer Pro"
      },
      {
        "command": "tensorViewer.getPro",
        "title": "Get Zovo Pro (USD 19 once, all Zovo viewers)",
        "category": "NumPy Viewer"
      },
      {
        "command": "tensorViewer.unlockWithSponsors",
        "title": "Unlock Zovo Pro with GitHub Sponsors",
        "category": "NumPy Viewer"
      },
      {
        "command": "tensorViewer.payWithPayPal",
        "title": "Pay for Zovo Pro with PayPal (USD 19)",
        "category": "NumPy Viewer"
      },
      {
        "command": "tensorViewer.enterLicenseKey",
        "title": "Enter Zovo Pro License Key",
        "category": "NumPy Viewer"
      },
      {
        "command": "tensorViewer.removeLicense",
        "title": "Remove Zovo Pro from This Editor",
        "category": "NumPy Viewer"
      }
    ],
    "configuration": {
      "title": "Tensor Viewer",
      "properties": {
        "tensorViewer.sampleValues": {
          "type": "number",
          "default": 2000000,
          "minimum": 10000,
          "maximum": 50000000,
          "description": "Most values read from one tensor for stats, the histogram and the heatmap. Larger tensors are sampled by whole rows spread evenly over the tensor."
        },
        "tensorViewer.maxRemoteFileMB": {
          "type": "number",
          "default": 512,
          "minimum": 1,
          "description": "Files that are not on local disk (remote or virtual workspaces) are read whole. Bigger files show a message instead."
        },
        "tensorViewer.autoReload": {
          "type": "boolean",
          "default": true,
          "description": "Read the file again when it changes on disk, for example when a training loop saves a new checkpoint. The selected tensor, filter and tab stay as they were. The change shows in files you open next."
        },
        "tensorViewer.askForRating": {
          "type": "boolean",
          "default": true,
          "description": "Ask for a rating after 2 files opened without an error in 2 sessions at least 4 hours apart. \"Rate it\" opens the Marketplace review page in VS Code and the Open VSX one in Cursor, Windsurf and VSCodium. \"Later\" asks one more time after 7 days, \"No thanks\" never asks again. It never asks after an error or more than 2 times. Nothing is sent anywhere."
        },
        "tensorViewer.showSupportLinks": {
          "type": "boolean",
          "default": true,
          "description": "Show the small Sponsor and More free viewers links at the bottom of the viewer. The change shows in files you open next. Nothing is sent anywhere."
        },
        "tensorViewer.showProFeatures": {
          "type": "boolean",
          "default": true,
          "description": "Show the Zovo Pro tools (the Compare with... and Scan all tensors buttons with their PRO badge, and the Pro commands). Turn it off to see only the free viewer. A Zovo Pro license always shows them."
        }
      }
    },
    "walkthroughs": [
      {
        "id": "tensorViewer.start",
        "title": "Get started with Tensor Viewer",
        "description": "Open NumPy, PyTorch, Safetensors and GGUF files and see what is inside.",
        "steps": [
          {
            "id": "open",
            "title": "Open a tensor file",
            "description": "Click any .npy, .npz, .pt, .pth, .ckpt, .safetensors or .gguf file in the Explorer. It opens in Tensor Viewer with the header read and every tensor listed. PyTorch files are read without running pickle.\n[Find a model file](command:workbench.action.quickOpen?%5B%22.safetensors%22%5D)",
            "media": {
              "image": "images/gguf.png",
              "altText": "A GGUF model open in Tensor Viewer with its metadata, tensor table and a heatmap."
            },
            "completionEvents": [
              "onCommand:workbench.action.quickOpen"
            ]
          },
          {
            "id": "inspect",
            "title": "Inspect one tensor",
            "description": "Click a row to see min, max, mean, std, NaN and Inf counts, a histogram, and a heatmap, line plot or image. Use the buttons to copy the shape as a Python tuple or torch.Size.",
            "media": {
              "markdown": "walkthrough/inspect.md"
            }
          },
          {
            "id": "settings",
            "title": "Tune the sample size",
            "description": "Big tensors are sampled by whole rows. Raise the sample size for exact stats on larger tensors.\n[Open settings](command:workbench.action.openSettings?%5B%22tensorViewer%22%5D)",
            "media": {
              "markdown": "walkthrough/settings.md"
            },
            "completionEvents": [
              "onCommand:workbench.action.openSettings"
            ]
          }
        ]
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "tensorViewer.openRaw",
          "when": "!explorerResourceIsFolder && resourceExtname =~ /^\\.(bin|raw|dat|data|f16|f32|f64|i8|u8|i16|u16|i32|u32|i64|u64|img|out)$/i",
          "group": "navigation@90"
        },
        {
          "command": "tensorViewer.compareFiles",
          "when": "listMultiSelection && !explorerResourceIsFolder && resourceExtname =~ /^\\.(npy|npz|safetensors|gguf|pt|pth|ckpt|bin)$/i && (config.tensorViewer.showProFeatures || tensorViewer.proLicensed)",
          "group": "3_compare@90"
        },
        {
          "command": "tensorViewer.scanTensors",
          "when": "!listMultiSelection && !explorerResourceIsFolder && resourceExtname =~ /^\\.(npy|npz|safetensors|gguf|pt|pth|ckpt|bin)$/i && (config.tensorViewer.showProFeatures || tensorViewer.proLicensed)",
          "group": "navigation@91"
        }
      ],
      "editor/title/context": [
        {
          "command": "tensorViewer.openRaw",
          "when": "resourceExtname =~ /^\\.(bin|raw|dat|data|f16|f32|f64|i8|u8|i16|u16|i32|u32|i64|u64|img|out)$/i",
          "group": "3_open@90"
        }
      ],
      "commandPalette": [
        {
          "command": "tensorViewer.compareFiles",
          "when": "config.tensorViewer.showProFeatures || tensorViewer.proLicensed"
        },
        {
          "command": "tensorViewer.scanTensors",
          "when": "config.tensorViewer.showProFeatures || tensorViewer.proLicensed"
        },
        {
          "command": "tensorViewer.getPro",
          "when": "config.tensorViewer.showProFeatures || tensorViewer.proLicensed"
        },
        {
          "command": "tensorViewer.unlockWithSponsors",
          "when": "config.tensorViewer.showProFeatures || tensorViewer.proLicensed"
        },
        {
          "command": "tensorViewer.payWithPayPal",
          "when": "config.tensorViewer.showProFeatures || tensorViewer.proLicensed"
        },
        {
          "command": "tensorViewer.enterLicenseKey",
          "when": "config.tensorViewer.showProFeatures || tensorViewer.proLicensed"
        },
        {
          "command": "tensorViewer.removeLicense",
          "when": "tensorViewer.proLicensed"
        }
      ]
    }
  },
  "scripts": {
    "build": "node scripts/build.js --production",
    "test": "node scripts/build.js --production && node --test \"test/*.test.js\"",
    "fixtures": "python3 scripts/make-fixtures.py test/fixtures",
    "package": "npm run build && npx -y @vscode/vsce package --no-dependencies -o dist/"
  },
  "devDependencies": {
    "@huggingface/gguf": "0.4.6",
    "esbuild": "0.28.2",
    "fflate": "0.8.3"
  },
  "homepage": "https://github.com/theluckystrike/tensor-viewer-vscode#readme",
  "bugs": {
    "url": "https://github.com/theluckystrike/tensor-viewer-vscode/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/theluckystrike/tensor-viewer-vscode"
  },
  "sponsor": {
    "url": "https://github.com/sponsors/theluckystrike"
  }
}
